{
  "name": "angular-cricket-frontend",
  "version": "0.2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start:demo": "ng serve --configuration demo",
    "dev:demo": "ng serve --configuration demo",
    "build:demo": "ng build --configuration demo",
    "parity:record": "node tools/parity.mjs record",
    "parity": "ng build --configuration demo && node tools/parity.mjs check",
    "smoke": "ng build --configuration demo && node tools/smoke.mjs",
    "verify": "ng test --watch=false && ng build --configuration demo && node tools/parity.mjs check && node tools/smoke.mjs",
    "icons": "node tools/icons.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "chart.js": "^4.5.1",
    "firebase": "^12.19.0",
    "rxjs": "~7.8.0",
    "three": "^0.128.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.0",
    "@types/three": "^0.128.0",
    "@types/web-bluetooth": "^0.0.21",
    "jsdom": "^28.0.0",
    "lucide-static": "1.55.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
